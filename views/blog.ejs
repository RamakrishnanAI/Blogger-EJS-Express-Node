<%- include('partials/header.ejs', { activePage: 'blog' }) %>
    <div class="row demo-row">
        <div class="col-lg-9">
            <div class="bp2">
                <div class="hero-banner">
                    <div class="container">
                        <span class="cat-tag"><%= blog?.main_tag %></span>
                        <h1>
                            <%= blog?.title || 'title' %>
                        </h1>
                        <div class="post-meta">
                            <img src="https://picsum.photos/seed/author2/100/100" alt="">
                            <div><span class="name"><%= blog?.author %></span> &middot; Aug 24, 2026 &middot; 12 min read</div>
                        </div>
                    </div>
                </div>
                <div class="container">
                    <div class="row">
                        <div class="col-lg-8 mx-auto">
                            <div class="article-body">
                                <%- blog?.blog_content || 'Content Not Available' %>
                            </div>
                            <div class="tags">
                                <% for(let i = 0; i < blog?.categories?.length; i++){ %>
                                    <a href="#"><%= blog?.categories[i] %></a>
                                <% } %>
                            </div>
                            <div class="share-bar">
                                <a href="#"><i class="fa-brands fa-twitter"></i></a>
                                <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
                                <a href="#"><i class="fa-solid fa-link"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <%- include('partials/sidebar.ejs', { topBlogs: topBlogs, topCategories: topCategories }) %>
    </div>
    <%- include('partials/footer.ejs') %>