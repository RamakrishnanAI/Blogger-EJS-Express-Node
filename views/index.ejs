<%- include('partials/header.ejs') %>

<div>
    <div class="row demo-row">
        <div class="col-lg-9">
            <div class="row main-header">
                <h1>Latest Blog Posts</h1>
            </div>
            <% for(let i = 0; i < blogList.length; i++) { %>
                <div class="card blog-card mb-3">
                    <div class="row g-0">
                        <div class="col-md-4">
                        <img src="<%= blogList[i]?.image || 'images/blog-placeholder.png' %>" class="img-fluid rounded-start" alt="Blog Post Image">
                        </div>
                        <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="card-title"><%= blogList[i]?.title || 'Card title' %></h5>
                            <p class="card-text"><%= blogList[i]?.description || 'This is a wider card with supporting text below as a natural lead-in to additional content. This content is a little bit longer.' %></p>
                            <div class="meta">Last updated <%= blogList[i]?.lastUpdated || '3 mins' %> ago</div>
                            <a href="/blogs/<%= blogList[i]?.blog_id || '' %>" class="select-blog d-block mt-4">Read Article <i class="fa-solid fa-arrow-right-long"></i></a>
                        </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
        <%- include('partials/sidebar.ejs', { topBlogs: topBlogs, topCategories: topCategories }) %>
        <div class="row d-flex align-items-center justify-content-center mt-4">
            <nav aria-label="Page navigation example">
                <ul class="pagination">
                    <li class="page-item">
                    <a class="page-link" href="#" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                    </li>
                    <li class="page-item"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item">
                    <a class="page-link" href="#" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<%- include('partials/footer.ejs') %>